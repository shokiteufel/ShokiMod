{
	"schemaVersion": 1,
	"id": "shokimod",
	"version": "${version}",
	"name": "ShokiMod",
	"description": "Hypixel Skyblock mod: rare loot alerts with designable banners, fusion/craft/forge profit screens, mining and pet HUDs, mob markers, critter safari helpers and chat rules with custom sounds. Fork of GanKura by GanKuraDee; CREDITS.md names every borrowed feature and its source mod.",
	"authors": [
		"ShokiTeufel"
	],
	"contributors": [
		"GanKuraDee"
	],
	"contact": {
		"homepage": "https://github.com/shokiteufel/ShokiMod",
		"sources": "https://github.com/shokiteufel/ShokiMod",
		"issues": "https://github.com/shokiteufel/ShokiMod/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/shokimod/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.shokiteufel.shokimod.ShokiMod"
		],
		"modmenu": [
			"com.shokiteufel.shokimod.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "shokimod.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"shokimod:upstream": "GanKura 6.4.0+26.1.x (fork point 39d3901, 2026-08-22)",
		"shokimod:credits": "https://github.com/shokiteufel/ShokiMod/blob/26.1.x/CREDITS.md"
	},
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
