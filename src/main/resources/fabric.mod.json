{
	"schemaVersion": 1,
	"id": "shokimod",
	"version": "${version}",
	"name": "ShokiTeufel",
	"description": "Hypixel Skyblock mod for area mini-bosses, own mob markers, critter safari extras and chat rules with custom sounds. Fork of GanKura by GanKuraDee.",
	"authors": [
		"ShokiTeufel",
		"GanKuraDee"
	],
	"contact": {
		"sources": "https://github.com/GanKuraDee/GanKura"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/shokimod/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.shokiteufel.shokimod.ShokiMod"
		],
		"modmenu": [
			"com.shokiteufel.shokimod.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "shokimod.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"shokimod:upstream": "GanKura 6.4.0+26.1.x"
	},
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
